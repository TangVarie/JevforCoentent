TYPESAFE_API_KEY=            # Jev 密钥，只放服务端（也可用 TYPESAFE_KEY_FILE 指向密钥文件）
TYPESAFE_BASE_URL=           # 可空；换 Jev 端点时用
JUDGE_API_KEY=               # HTTP 调用方要带的 X-Judge-Key；不配则服务拒绝所有请求（fail-closed）
JUDGE_ALLOW_ANONYMOUS=0      # 本地开发不想配 key 时显式设 1；线上不要设
JUDGE_WORKERS=4              # /judge 一批 subject 并行几路
SUPABASE_URL=                # 直接写账本时用（可空，只出 SQL / rows.json）
SUPABASE_SERVICE_ROLE_KEY=   # 与 truth-vault 同名
TIKHUB_API_KEY=              # 外部语料（每次请求 0.01 美元）
JUDGE_MOCK=0                 # 1 = 不联网的假 Jev；它判的行 extractor 是 mock:<模型>，任何写库请求一律拒绝；线上不要设
JUDGE_PROJECT=               # 写手侧 MCP 的默认项目代号（数据出境：未发布稿必须知道是哪个项目）
JUDGE_CATEGORY=              # 可空；写手侧 MCP 的默认品类（TV 统一词表，处方药会被拒）
TIKHUB_BASE_URL=             # 可空；换 TikHub 端点时用
ANTHROPIC_BASE_URL=          # 可空；loop 生成端适配器（中转站地址，末尾带不带 /v1 都行）
ANTHROPIC_API_KEY=           # 可空；没有就读 MOONSHOT_API_KEY；/compile_rules 要它（没配 503）
JUDGE_COMPILE_MODEL=         # 可空；/compile_rules 的编译模型，默认 claude-sonnet-5-5
JUDGE_COMPILE_EFFORT=low     # output_config.effort；中转站不认这个字段时设成空
JUDGE_COMPILE_BATCH=10       # 每次调用编几条规则（1–20）
JUDGE_COMPILE_WORKERS=6      # 几路并行（1–12）
JUDGE_COMPILE_TIMEOUT_SEC=90 # 单次编译调用超时（5–300）
JUDGE_COMPILE_RETRIES=1      # 429 / 5xx / 连不上的重试次数（0–3）
