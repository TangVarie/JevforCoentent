TYPESAFE_API_KEY=            # Jev 密钥，只放服务端（也可用 TYPESAFE_KEY_FILE 指向密钥文件）
TYPESAFE_BASE_URL=           # 可空；换 Jev 端点时用
JUDGE_API_KEY=               # HTTP 调用方要带的 X-Judge-Key；不配则服务拒绝所有请求（fail-closed）
JUDGE_ALLOW_ANONYMOUS=0      # 本地开发不想配 key 时显式设 1；线上不要设
JUDGE_WORKERS=4              # /judge 一批 subject 并行几路
SUPABASE_URL=                # 直接写账本时用（可空，只出 SQL / rows.json）
SUPABASE_SERVICE_ROLE_KEY=   # 与 truth-vault 同名
TIKHUB_API_KEY=              # 外部语料（每次请求 0.01 美元）
JUDGE_MOCK=0                 # 1 = 不联网的假 Jev；它判的行 extractor 是 mock:<模型>，任何写库请求一律拒绝；线上不要设
JUDGE_PROJECT=               # 写手侧 MCP 的默认项目代号（数据出境：未发布稿必须知道是哪个项目）
JUDGE_CATEGORY=              # 可空；写手侧 MCP 的默认品类（TV 统一词表，处方药会被拒）
TIKHUB_BASE_URL=             # 可空；换 TikHub 端点时用
ANTHROPIC_BASE_URL=          # 可空；loop 生成端适配器（中转站地址，末尾带不带 /v1 都行）
ANTHROPIC_API_KEY=           # 可空；没有就读 MOONSHOT_API_KEY；/compile_rules 要它（没配 503）
JUDGE_COMPILE_MODEL=         # 可空；/compile_rules 的编译模型，默认 claude-sonnet-5-5
JUDGE_COMPILE_EFFORT=low     # output_config.effort；中转站不认这个字段时设成空
JUDGE_COMPILE_BATCH=10       # 每次调用编几条规则（1–20）
JUDGE_COMPILE_WORKERS=6      # 几路并行（1–12）
JUDGE_COMPILE_TIMEOUT_SEC=90 # 单次编译调用超时（5–300）
JUDGE_COMPILE_RETRIES=1      # 429 / 5xx / 连不上的重试次数（0–3）
ANTHROPIC_BASE_URL_BACKUP=   # 可空；备用中转站地址（D-148）。和下一行两个都填了才启用，缺一个等于没配，行为和现在完全一样
ANTHROPIC_API_KEY_BACKUP=    # 可空；备用中转站 key（只用于备用站，主站照旧用 ANTHROPIC_API_KEY）
RELAY_FORCE=                 # 可空 = 自动切换；primary = 只走主站（同没配备用站）；backup = 只走备用站
# 下面四个一般不用动（留空 = 默认）：
# RELAY_PRIMARY_TIMEOUT_S=   # 自动模式下主站单次限时（5–600 秒），默认 = JUDGE_COMPILE_TIMEOUT_SEC
# RELAY_SLOW_S=              # 主站成功但慢于这个秒数也算一次失败（0–600，0 = 不按慢判），Jev 默认 0
# RELAY_BREAKER_FAILS=       # 主站连续失败几次熔断（1–20，默认 2）
# RELAY_BREAKER_COOLDOWN_S=  # 熔断多久只走备用站（30–86400 秒，默认 1200）
# 下面这些也是代码实际读的（Railway 上直接配；留空 = 默认）。只写名字和意思，不写值：
# JUDGE_WRITER_API_KEYS=       # 受限 key（逗号分隔），只够 /banks、/judge_draft（不写库）和两个只读评论端点；给起 judge.mcp_server 的内部机器
# JUDGE_COMMENT_TOOLS_ENABLED= # 1 = 打开评论相关端点；不设 = 关
# JUDGE_BANKS_DIR=             # 题库目录，默认仓库里的 banks/
# JUDGE_POLICY_CONFIG=         # 数据出境配置路径，默认 config/data_policy.yaml
# JUDGE_HIDDEN_CONFIG=         # 暗题轮换配置路径，默认 config/hidden_rotation.yaml
# JUDGE_TZ=                    # 暗题按哪个时区算季度，默认 Asia/Shanghai（设成空串也是这个默认）
# MOONSHOT_API_KEY=            # ANTHROPIC_API_KEY 没配时生成端的备用密钥名
# TYPESAFE_KEY_FILE=           # Jev 密钥放在文件里时的路径（TYPESAFE_API_KEY 为空时才读）
# JEV_TIMEOUT_SEC=             # 单次 Jev 调用超时秒数（默认 30；越界夹到 1–120，写坏了按默认）；为什么给写作台服务的部署调小，见 judge/jev_client.py 的 JevClient
# JEV_RETRIES=                 # Jev 429 / 5xx / 连不上时的重试次数（默认 3；越界夹到 0–5，写坏了按默认）
# ANTHROPIC_CUSTOM_HEADERS=    # 不用设：本服务发请求不带它；共享的 judge/relay.py 里只有 SDK 备用站客户端（本服务没用到）会在它非空时记一条警告
# 只给 judge.mcp_server（起在内部机器上的 MCP 薄客户端）用：
# JUDGE_URL=                   # judge HTTP 服务地址；配合 JUDGE_API_KEY 或写手 key
# JUDGE_HTTP_TIMEOUT_SEC=180   # MCP 调 judge HTTP 的超时秒数
# JUDGE_ALLOW_LOCAL_JEV=0      # 只有等于 1 时，评论三个工具（judge_comments / comment_repair_plan_for / judge_thread）才在本机进程内调 Jev
#                              #   （要本机有 Jev 密钥和 banks/）；不设或别的值，这三个工具直接回 error。judge_draft / repair_plan_for / list_banks
#                              #   不看它，始终走 HTTP 服务；HTTP 服务本身也不读它。只在合法持有 Jev 密钥的内部 / 运维机器上设
